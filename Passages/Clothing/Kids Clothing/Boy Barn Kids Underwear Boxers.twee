:: Boy Barn Kids Underwear Boxers [nobr]
<span style="color:Azure"><strong>-Boxers ($3)-</strong></span><br>
/* AVATAR DISPLAY */
	<<set $AD.Name to "Noah">>
	<<set $AD.Arms to "Normal">>
	<<set $AD.Eyes to "Normal">>
	<<set $AD.Cry to 0>>
	<<set $AD.Blush to 1>>
	<<set $AD.Mouth to "Happy">>
	<<set $AD.Outfit to "Everyday Outside">>
	<<set $AD.Hard to 0>>

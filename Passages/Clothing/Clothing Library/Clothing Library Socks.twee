:: Clothing Library Socks Socks [nobr]

<<set _clothingtemp to {
	Name: _color + " Socks",
    Type: "Socks",
    Color: _color,
    Slot: "Socks",
    Temp: 0,
    Tags: ["None"],
    Durability: 5,
    MaxDurability: 5,
    Weight: 1,
    Size: "Preteen",
    Icon: "Images/Equipment/Socks/" + _color + " Socks.png",
    Avatar: "Images/Avatar/Clothes/Socks/" + _color + " Socks.png",
    AvatarTorn: "None",
    AvatarDamaged: "None",
    Description: "A pair of warm, comfy socks.",
}>>


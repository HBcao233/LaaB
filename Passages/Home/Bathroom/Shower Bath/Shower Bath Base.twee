:: Shower Base [nobr]

/* Intro */
/* Checking if player is already considered Nude */
<<if $PlayerBottoms.Type != "None" or $PlayerTop.Type != "None" or $Player.Undies != "None">>
    XXX
<<else>>
    XXX
<</if>>

/* Default Post-Intro Avatar */
<<set _ad to [
    {
        Name: "Player",
        ShowZoom: true,
        State: {
            Outfit: "Naked",
            Mouth: "Happy",
        },
    },
]>>
<<ad _ad>>

/* Naturism Check */
<<if $HomeDayNudity <= 0>>
    PLAYER_IS_EMBARRASSED
<<else>>
    PLAYER_IS_FINE
<</if>>


:: PH Kitchen Naked [nobr]

/* LOCATION */
<<set $Location to {
	Name: "Home Kitchen",
    Indoors: 1,
    Safe: 1,
    Nudity: 0,
    Public: 0,
    Environment: "Kitchen",
}>>

/* SETTING STATE */
<<if $Time.before(22) and $Time.after(6)>>

/* EYEBROWS */

<<if ["Normal", "Closed"].contains($AD.Eyes)>>
	<<set _eyebrows to "">>
<<else>>
	<<set _eyebrows to $AD.Eyes + "/">>
<</if>>

<img @src="`Images/Avatar/Teen/Eyebrows/${_eyebrows}${$AD.HairColor}.png`"
	style="position: absolute; left: 0; top: 0">


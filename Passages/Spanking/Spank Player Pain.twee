	<span style="color:lightblue">Your butt feels fine.</span>
	<<else>>
	<span style="color:lightblue">A cold breeze tickles your exposed butt.</span>
	<</if>>
	
<<elseif $SpankPain <= 20>>
	<span style="color:lightcoral">Your butt stings from the pain.</span>

<<elseif $SpankPain <= 40>>

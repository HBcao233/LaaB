:: CARTER Inspect School Waiting for Bus [nobr]

<<set _ad to [
	{
		Name: "Carter",
		State: {
			Mouth: "Happy",
			Outfit: "Uniform",
		},
	},
]>>
<<ad _ad>>

<span style="color:DarkTurquoise">Carter</span> happily hops from rock to rock while he waits for the bus. Despite nearly falling at one point, he continues to make further and further jumps.<br>
<br>
	/* HANG OUT */
	
<div id="HangOutSchool">
	<<if $InActiveQuests.includes("Carter: Hang Out Intro")>>
		<<link"Ask if Carter wants to Hang Out">>
		<<set $HangOutNeed to {
			Energy: 100,
			Fun: 20,
			Comfort: 20,
		}>>
		<<goto "Carter Hang Out First Time">>
		<</link>><br>
	<<elseif $CompletedQuests.includes("Carter: Hang Out Intro")>>
		<<link"Want to hang out?">>
		<<replace"#HangOutSchool">>
			<span style="color:Yellow">Where?</span><br>
			<<set $HangOutNeed to {
				Energy: 100,
				Fun: 20,
				Comfort: 20,
			}>>
			<<link"The Park (0:10)<br>">>
				<<set $HangOutClothes to "Uniform">>
				<<set $Minutes += 10>>
				<<goto "Carter Hang Out Go To Park">>
			<</link>>
			<<link"The Arcade (0:05)<br>">>
				<<set $HangOutClothes to "Uniform">>
				<<set $Minutes += 5>>
				<<goto "Carter Hang Out Arcade Intro">>
			<</link>>
			<<link"The Mall (0:15)<br>">>
				<<set $HangOutClothes to "Uniform">>
				<<set $Minutes += 15>>
				<<goto "Carter Hang Out Mall Intro">>
			<</link>>
			<br>
		<</replace>>
		<</link>>
	<</if>>
</div>
[[Leave|Middle School]] 


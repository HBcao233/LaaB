:: BEN Inspect School Waiting for Bus [nobr]

<<set _ad to [
	{
		Name: "Ben",
		State: {
			Outfit: "Uniform",
		},
	},
]>>
<<ad _ad>>

<span style="color:DarkTurquoise">Ben</span> stands a bit away from the main group of boys waiting for the bus. He seems to not want to draw attention to himself.<br>
<br>
<div id="HangOutSchool">
	<<if $InActiveQuests.includes("Ben: Hang Out Intro")>>
		<<link"Ask if Ben wants to Hang Out">>
		<<set $HangOutNeed to {
			Energy: 100,
			Fun: 20,
			Comfort: 20,
		}>>
		<<goto "Ben Hang Out First Time">>
		<</link>><br>
	<<elseif $CompletedQuests.includes("Ben: Hang Out Intro")>>
		<<link"Want to hang out?">>
		<<replace"#HangOutSchool">>
			<span style="color:Yellow">Where?</span><br>
			<<set $HangOutNeed to {
				Energy: 100,
				Fun: 20,
				Comfort: 20,
			}>>
			<<link"The Park (0:10)<br>">>
				<<set $HangOutClothes to "Uniform">>
				<<set $Minutes += 10>>
				<<goto "Ben Hang Out Go To Park">>
			<</link>>
		<</replace>>
		<</link>>
	<</if>>
</div>


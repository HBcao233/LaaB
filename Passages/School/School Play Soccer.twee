<br>
<span style="color:LightGreen">You spend some time playing Soccer. You feel your Athletics improve!</span><br>
    <<skillPoints "Athletics" 3>>
<<needChange "Energy" -1>>
<<needChange "Hygiene" -1>>
<<needChange "Fun" 20>>

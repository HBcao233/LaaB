:: Quest Journal [nobr]

<<if $Debug == 1>>
    <span style="color:Azure"><big><strong>--Debug Info--</strong></big></span><br>
    <strong>Unavailable Quests</strong>: <br>
    <div style="margin-left: 30px;">
        $UnavailableQuests<br>
    </div>
    <strong>Inactive Quests</strong>: <br>
    <div style="margin-left: 30px;">
        $InActiveQuests<br>
    </div>
    <strong>Active Quests</strong>: <br>
    <div style="margin-left: 30px;">
        $ActiveQuests<br>
    </div>
    <strong>Completed Quests</strong>: <br>
    <div style="margin-left: 30px;">
        $CompletedQuests<br>
    </div>
    <br>
<</if>>

<span style="color:Azure"><big><strong>--Quest Journal--</strong></big></span><br>

<<link "Family">>
    <<replace "#cate">>
    <<include "Quest Journal Family">>
    <</replace>>
<</link>>
 | 
<<link "Core Classmates">>
    <<replace "#cate">>
    <<include "Quest Journal Core Classmates">>
    <</replace>>
<</link>>
 | 
<<link "Child Townies">>
    <<replace "#cate">>
    <<include "Quest Journal Child Townies">>
    <</replace>>
<</link>>
 | 
<<link "Preteen Townies">>
    <<replace "#cate">>
    <<include "Quest Journal Preteen Townies">>
    <</replace>>
<</link>>
 | 
<<link "Teen Townies">>
    <<replace "#cate">>
    <<include "Quest Journal Teen Townies">>
    <</replace>>
<</link>> /*
 | 
<<link "Adult Townies">>
    <<replace "#cate">>
    <<include "Quest Journal Adult Townies">>
    <</replace>>
<</link>> */

<div id="cate">
    <<include"Quest Journal Family">>
</div>


<br>
[[Back|Journal]]

:: Quest Journal Family [nobr]

<<include"Quest Journal Core Noah">>
<<include"Quest Journal Core Gabe">>
<<include"Quest Journal Core Dad">>

:: Quest Journal Core Noah [nobr]

<span style="color:Azure"><big><strong>--Noah--</strong></big></span><br>
<div style="margin-left: 30px;">

    /* Noah: Hang Out Intro */
    <<if $UnavailableQuests.includes("Noah: Hang Out Intro")>>
        -??? 
        <<if $QuestHints == 1>>
            <span style="color:Gray">(Requires: Social 10+)</span>
        <</if>>
        <br>
    <<elseif $InActiveQuests.includes("Noah: Hang Out Intro")>>
        -??? (Available)
        <<if $QuestHints == 1>>
                <span style="color:Gray">(Triggers: Ask to Hang Out at Home)</span>
        <</if>>
        <br>
    <<elseif $ActiveQuests.includes("Noah: Hang Out Intro")>>
        <span style="color:lightgreen"><strong>-Noah</strong>: Hang Out Intro</span><br>
    <<elseif $CompletedQuests.includes("Noah: Hang Out Intro")>>
        <span style="color:green"><strong>-Noah</strong>: Hang Out Intro (Completed)</span><br>
    <</if>>

    <<if passage() is "Cheats Menu" and !($InActiveQuests.includes("Noah: Hang Out Intro") or $CompletedQuests.includes("Noah: Hang Out Intro"))>>
        <<link "(Make Available)">>
            <<set _q = "Noah: Hang Out Intro">>

            <<run $UnavailableQuests.delete(_q)>>
            <<run $ActiveQuests.delete(_q)>>
            <<if !$InActiveQuests.includes(_q)>>
                <<run $InActiveQuests.push(_q)>>
            <</if>>

            <<goto "Cheats Menu">>
        <</link>>
        -
    <</if>>
    <<if passage() is "Cheats Menu" and !$CompletedQuests.includes("Noah: Hang Out Intro")>>
    <<link "(Complete)">>
        <<set _q = "Noah: Hang Out Intro">>

        <<run $UnavailableQuests.delete(_q)>>
        <<run $InActiveQuests.delete(_q)>>
        <<run $ActiveQuests.delete(_q)>>
        <<if !$CompletedQuests.includes(_q)>>
            <<run $CompletedQuests.push(_q)>>
        <</if>>

        <<goto "Cheats Menu">>
    <</link>>
    <br>
    <</if>>

    /* Noah: Missing Toy */
    <<if $UnavailableQuests.includes("Noah: Missing Toy")>>
        -???
        <<if $QuestHints == 1>>
            <span style="color:Gray">(Requires: 25% to spawn every Wednesday | Repeatable)</span>
        <</if>>
        <br>
    <<elseif $InActiveQuests.includes("Noah: Missing Toy") && !$CompletedQuests.includes("Noah: Missing Toy")>>
        -??? (Available)
        <<if $QuestHints == 1>>
            <span style="color:Gray">(Triggers: Wednesday | Talk to Noah)</span>
        <</if>>
        <br>
    <<elseif $ActiveQuests.includes("Noah: Missing Toy") && !$CompletedQuests.includes("Noah: Missing Toy")>>
        <span style="color:lightgreen"><strong>-Noah</strong>: Missing Toy</span><br>
    <<elseif $CompletedQuests.includes("Noah: Missing Toy")>>
        <span style="color:green"><strong>-Noah</strong>: Missing Toy (Completed)</span><br>
    <</if>>

    <<if passage() is "Cheats Menu" and !($InActiveQuests.includes("Noah: Missing Toy") or $CompletedQuests.includes("Noah: Missing Toy"))>>
        <<link "(Make Available)">>
            <<set _q = "Noah: Missing Toy">>

            <<run $UnavailableQuests.delete(_q)>>
            <<run $ActiveQuests.delete(_q)>>
            <<if !$InActiveQuests.includes(_q)>>
                <<run $InActiveQuests.push(_q)>>
            <</if>>

            <<goto "Cheats Menu">>
        <</link>>
        -
    <</if>>
    <<if passage() is "Cheats Menu" and !$CompletedQuests.includes("Noah: Missing Toy")>>
    <<link "(Complete)">>
        <<set _q = "Noah: Missing Toy">>

        <<run $UnavailableQuests.delete(_q)>>
        <<run $InActiveQuests.delete(_q)>>
        <<run $ActiveQuests.delete(_q)>>
        <<if !$CompletedQuests.includes(_q)>>
            <<run $CompletedQuests.push(_q)>>
        <</if>>
        <<goto "Cheats Menu">>
    <</link>>
    <br>
    <</if>>

    /* Noah: Booster Shot */
    <<if $UnavailableQuests.includes("Noah: Booster Shot")>>
        -???
        <<if $QuestHints == 1>>
            <span style="color:Gray">(Requires: Noah Social 50+)</span>
        <</if>>
        <br>
    <<elseif $InActiveQuests.includes("Noah: Booster Shot")>>
        -??? (Available)
        <<if $QuestHints == 1>>
            <span style="color:Gray">(Triggers: Weekend | Before 4PM | Player's Living Room)</span>
        <</if>>
        <br>
    <<elseif $ActiveQuests.includes("Noah: Booster Shot")>>

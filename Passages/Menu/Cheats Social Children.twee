        <tr>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $LeviSocial,
                    value: Math.abs($LeviSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($LeviSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $WilliamSocial,
                    value: Math.abs($WilliamSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($WilliamSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $MateoSocial,
                    value: Math.abs($MateoSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($MateoSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $TheoSocial,
                    value: Math.abs($TheoSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($TheoSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $EthanSocial,
                    value: Math.abs($EthanSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($EthanSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
                </tr>

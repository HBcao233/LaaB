	</div>
	<div>
		[[(+)|Cheats Menu][$Player.Hunger += 5]]
		[[(++)|Cheats Menu][$Player.Hunger += 20]]
		[[(Max)|Cheats Menu][$Player.Hunger to 100]]&nbsp;
		<<if $CheatsHunger === 0>>

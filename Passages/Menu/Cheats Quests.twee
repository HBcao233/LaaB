<div id=CheatsQuestsMenu>
	<<if $CheatsQuests == "Core Characters">>
		<<include"Cheats Quests Core Characters">>
	<<elseif $CheatsQuests == "Children">>
		<<include"Cheats Quests Children">>
	<<elseif $CheatsQuests == "Preteens">>
		<<include"Cheats Quests Preteens">>
	<<elseif $CheatsQuests == "Teens">>
		<<include"Cheats Quests Teens">>
	<<else>>
		<<include"Cheats Quests Core Characters">>
	<</if>>
</div>

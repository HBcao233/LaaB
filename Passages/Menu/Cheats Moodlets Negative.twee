	</span>
	<strong>Stressed:</strong>
		Stress Level: 
		<<link"(-)">>
        	<<addMoodlet "Stress" 0>>
			<<goto "Cheats Menu">>
		<</link>>
		<<link"(-)">>
        	<<addMoodlet "Stress" 1>>
			<<goto "Cheats Menu">>
		<</link>>

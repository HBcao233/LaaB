:: Options Nicknames [nobr]

<<if $BoxNickname is undefined>>
	<<set $BoxNickname to $Player.Name>>
<</if>>

<div id="options-nicknames-content">
	<<include "Options Nicknames Content">>
</div>
:: Options Nicknames Content [nobr]

<span style="color:Azure"><big><strong>--Nicknames--</strong></big></span><br>

[Note: Nicknames are unlocked the first time they are given to you. You can set custom nicknames by typing in the Text Box at the bottom and clicking <strong>[Set]</strong>. You can <strong>[Lock]</strong> the Bully Nickname to prevent it from changing during normal gameplay.]<br>
<br>

<span style="color:Azure"><strong>--Social Nicknames--</strong></span><br>

<<if $Nickname.Bully == 0>>
	<strong>Bully:</strong> $BullyNickname <span style="color:lightcoral"><strong>(Locked)</strong></span>
<<elseif $Nickname.Bully == 1>>
	<strong>Bully:</strong> $BullyNickname
	<<link "[Lock]">>
		<<set $Nickname.Bully to -1>>
		<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
	<</link>> |
	<<link "[Set]">>
		<<set $BullyNickname to $BoxNickname>>
		<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
	<</link>>
<<elseif $Nickname.Bully == -1>>
	<strong>Bully:</strong> $BullyNickname
	<<link "[Unlock]">>
		<<set $Nickname.Bully to 1>>
		<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
	<</link>>
<</if>>

<br><br>

<span style="color:Azure"><strong>--Family Nicknames--</strong></span><br>

<strong>Dad:</strong> $DadNickname
<<link "[Set]">>
	<<set $DadNickname to $BoxNickname>>
	<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
<</link>><br>

<strong>Gabe:</strong> $GabeNickname
<<link "[Set]">>
	<<set $GabeNickname to $BoxNickname>>
	<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
<</link>><br>

<strong>Noah:</strong> $NoahNickname
<<link "[Set]">>
	<<set $NoahNickname to $BoxNickname>>
	<<replace "#options-nicknames-content">><<include "Options Nicknames Content">><</replace>>
<</link>>

<br><br>


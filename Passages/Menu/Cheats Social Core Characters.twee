:: Cheats Social Core Characters [nobr]

<<set $CheatsSocial to "Core Characters">>

<span style="color:Azure"><big><strong>--Family--</strong></big></span><br>

<table style="border-collapse: separate; border-spacing: 15px 0;">
    <tr>
        <th>
            <span style="display: inline-flex; align-items: center; position: relative;">
                <<if $NoahSocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $NoahSocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $NoahSocial > -10 && $NoahSocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $NoahSocial <= -10 && $NoahSocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $NoahSocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Noah1.png`" style="position: absolute; width: 100px; height: 100px;"> 
            </span>
        </th>
        <th>
            <span style="display: inline-flex; align-items: center; position: relative;">
                <<if $GabeSocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $GabeSocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $GabeSocial > -10 && $GabeSocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $GabeSocial <= -10 && $GabeSocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $GabeSocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Default1.png`" style="position: absolute; width: 100px; height: 100px;"> 
            </span>
        </th>
        <th>
            <span style="display: inline-flex; align-items: center; position: relative;">
                <<if $DadSocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $DadSocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $DadSocial > -10 && $DadSocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $DadSocial <= -10 && $DadSocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $DadSocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dad1.png`" style="position: absolute; width: 100px; height: 100px;"> 
            </span>
        </th>
    </tr>
    <tr>
        <th style="text-align: center;">
            Noah
        </th>
        <th style="text-align: center;">
            Gabe
        </th>
        <th style="text-align: center;">
            Dad
        </th>
        <div style="text-align: center; margin-top: 8px;">
</div>
    </tr>
    <tr>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $NoahSocial,
                    value: Math.abs($NoahSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($NoahSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $GabeSocial,
                    value: Math.abs($GabeSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($GabeSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $DadSocial,
                    value: Math.abs($DadSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($DadSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
    </tr>
    <th>
        [[(--)|Cheats Menu][$NoahSocial -= 10]]
        [[(-)|Cheats Menu][$NoahSocial -= 5]]
        [[(+)|Cheats Menu][$NoahSocial += 5]]
        [[(++)|Cheats Menu][$NoahSocial += 10]]
    </th>
    <th>
        [[(--)|Cheats Menu][$GabeSocial -= 10]]
        [[(-)|Cheats Menu][$GabeSocial -= 5]]
        [[(+)|Cheats Menu][$GabeSocial += 5]]
        [[(++)|Cheats Menu][$GabeSocial += 10]]
    </th>
    <th>
        [[(--)|Cheats Menu][$DadSocial -= 10]]
        [[(-)|Cheats Menu][$DadSocial -= 5]]
        [[(+)|Cheats Menu][$DadSocial += 5]]
        [[(++)|Cheats Menu][$DadSocial += 10]]
    </th>
    <tr>
    <th style="text-align: center;">
        [[Rank Up|Cheats Menu][$NoahSocialRank to 1]]
    </th>
    </tr>
</table>

<span style="color:Azure"><big><strong>--Classmates--</strong></big></span><br>


:: Preteens Characters Social [nobr]

<<link"[Core Characters]">>
	<<replace"#SocialMenu">>
        <<include"Core Characters Social">>
    <</replace>>
<</link>>
 | 
<<link"[Children]">>
	<<replace"#SocialMenu">>
        <<include"Child Characters Social">>
    <</replace>>
<</link>>
 | 
<span style="color:lightgreen">[Preteens]</span>
 | 
<<link"[Teens]">>
	<<replace"#SocialMenu">>
        <<include"Teens Characters Social">>
    <</replace>>
<</link>>
 | 
 <<link"[Adults]">>
	<<replace"#SocialMenu">>
        <<include"Adult Characters Social">>
    <</replace>>
<</link>>

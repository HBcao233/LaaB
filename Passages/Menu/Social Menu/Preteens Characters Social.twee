                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Don1.png`" style="position: absolute; width: 100px; height: 100px;">
                    <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                        <<replace "#SocialMenu">>
                            <<include "OC Don NPC Character Menu">>
                        <</replace>>
                    <</link>>
            </span>
        </th>
    <<elseif $ToggleOCDon == 1>>
        <th>
            <span style="display: inline-flex; align-items: center; position: relative;">
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Unknown.png`" style="position: absolute; width: 100px; height: 100px;"> 
            </span>
        </th>
    <</if>>
    </tr>
    <tr>
        <<if $ToggleOCDon == 1 && $CompletedQuests.includes("Don: Introduction")>>
            <th style="text-align: center;">
            <<link"Don">>
                <<replace"#SocialMenu">>
                    <<include"OC Don NPC Character Menu">>
                <</replace>>
            <</link>>
            </th>
        <<elseif $ToggleOCDon>>
            <th style="text-align: center;">
                ????
            </th>
        <</if>>
    </tr>
        <tr>
        <<if $ToggleOCDon == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCDonSocial,
                        value: Math.abs($OCDonSocial),
                        max: 100,
                        min: 0,
                        color: getSocialBarColor($OCDonSocial),
                        showText: true,
                    })>>
                    <<progressbar _data>>
                </div>
            </th>
        <</if>>
    </tr>
</table>

<br>

<span style="color:Azure"><big><strong>--Classmates--</strong></big></span><br>

<table style="border-collapse: separate; border-spacing: 15px 0;">
    <tr>
        <<if $ToggleOCMiller == 1 && $CompletedQuests.includes("Millers: Meet the Millers")>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative; width:100px; height:100px;">
                <<if $OCZaySocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $OCZaySocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $OCZaySocial > -10 && $OCZaySocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $OCZaySocial <= -10 && $OCZaySocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $OCZaySocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Isaiah1.png`" style="position: absolute; width: 100px; height: 100px;">
                    <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                        <<replace "#SocialMenu">>
                            <<include "OC Zay NPC Character Menu">>
                        <</replace>>
                    <</link>>
                </span>
            </th>
        <<elseif $ToggleOCMiller == 1>>
            <th>
                <span style="display: inline-flex; align-items: center; position: relative;">
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Unknown.png`" style="position: absolute; width: 100px; height: 100px;"> 
                </span>
            </th>
        <</if>>
        <<if $ToggleOCSebastian == 1 && $CompletedQuests.includes("Nyalls: Sebastian")>>

:: OC Richard NPC Character Menu Model Viewer [nobr]

<<link"[Biography]">>
    <<replace"#NPCMenu">>
        <<include"OC Richard NPC Character Menu Biography">>
    <</replace>>
<</link>>
 | 
<<link"[Information]">>
    <<replace"#NPCMenu">>
        <<include"OC Richard NPC Character Menu Information">>
    <</replace>>
<</link>>
 | 
<<link"[Quests]">>
    <<replace"#NPCMenu">>
        <<include"OC Richard NPC Character Menu Quests">>
    <</replace>>
<</link>>
 | 
 <span style="color:lightgreen">[Model Viewer]</span>

    <<set $NPCViewer to {
        Name: "OC Richard",
        Outfit: "Everyday",
        Mouth: "Happy",
        Eyes: "Normal",
        Blush: 0,
        Cry: 0,
        Arms:  "Normal",
    }>>

<<set _npcviewerOutfit to ["Everyday", "Uniform", "Gym", "Gym Swim"]>>
<<set _npcviewerMouth to ["Happy", "Normal", "Sad", "Smirk"]>>
<<set _npcviewerEyes to ["Normal", "Mad", "Sad", "Tired", "Left Wink", "Right Wink", "Closed"]>>
<<set _npcviewerBlush to [0, 1, 2, 3]>>
<<set _npcviewerCry to [0, 1, 2]>>
<<set _npcviewerArms to ["Normal", "Bound", "Hide"]>>
<<set _npcviewerHard to [0]>>
<<if $OCRichardSocial >= 50 or $OCRichardSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $OCRichardSocial >= 100 or $OCRichardSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Model Viewer">>
</div>
<br>

:: OC Richard NPC Character Menu Avatar Display [nobr]

<<set $NPCViewer to {
    Name: "OC Richard",
    Outfit: "Everyday",
}>>

<<set _npcviewerOutfit to ["Everyday", "Uniform", "Gym", "Gym Swim"]>>
<<set _npcviewerHard to [0]>>
<<if $OCRichardSocial >= 50 or $OCRichardSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $OCRichardSocial >= 100 or $OCRichardSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Viewer">>
</div>
<br>
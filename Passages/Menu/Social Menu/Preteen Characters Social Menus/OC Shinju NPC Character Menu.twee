 <span style="color:lightgreen">[Model Viewer]</span>

    <<set $NPCViewer to {
        Name: "OC Shinju",
        Outfit: "Everyday",
        Mouth: "Happy",
        Eyes: "Normal",
        Blush: 0,
        Cry: 0,
        Arms:  "Normal",
    }>>

<<set _npcviewerOutfit to ["Everyday", "Hoodie", "Uniform", "Gym", "Gym Swim", "Terrorscale", "Psycoranger", "Tiger"]>>
<<set _npcviewerMouth to ["Happy", "Normal", "Sad", "Smirk"]>>
<<set _npcviewerEyes to ["Normal", "Mad", "Sad", "Tired", "Left Wink", "Right Wink", "Closed"]>>
<<set _npcviewerBlush to [0, 1, 2, 3]>>
<<set _npcviewerCry to [0, 1, 2]>>
<<set _npcviewerArms to ["Normal", "Bound", "Hide"]>>
<<set _npcviewerHard to [0]>>
<<if $OCShinjuSocial >= 50 or $OCShinjuSocialRank > 0>>
    <<set _npcviewerOutfit.push("Psycoranger", "Tiger", "Undies")>>
<</if>>
<<if $CompletedQuests.includes("Shinju: Felix Monster Event")>>
    <<set _npcviewerOutfit.push("Goldrax")>>
<</if>>
<<if $OCShinjuSocial >= 100 or $OCShinjuSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>

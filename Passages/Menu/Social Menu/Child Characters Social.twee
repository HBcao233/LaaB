        <tr>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $LeviSocial,
                    value: Math.abs($LeviSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($LeviSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $WilliamSocial,

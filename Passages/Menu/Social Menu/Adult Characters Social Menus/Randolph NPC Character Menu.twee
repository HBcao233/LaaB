:: Randolph NPC Character Menu Model Viewer [nobr]

<<link"[Biography]">>
    <<replace"#NPCMenu">>
        <<include"Randolph NPC Character Menu Biography">>
    <</replace>>
<</link>>
 | 
<<link"[Information]">>
    <<replace"#NPCMenu">>
        <<include"Randolph NPC Character Menu Information">>
    <</replace>>
<</link>>
 | 
<<link"[Quests]">>
    <<replace"#NPCMenu">>
        <<include"Randolph NPC Character Menu Quests">>
    <</replace>>
<</link>>
 | 
 <span style="color:lightgreen">[Model Viewer]</span>

    <<set $NPCViewer to {
        Name: "Randolph",
        Outfit: "Everyday",
        Mouth: "Happy",
        Eyes: "Normal",
        Blush: 0,
        Cry: 0,
        Arms: "Normal",
        Brows: "Normal",
    }>>

<<set _npcviewerOutfit to ["Everyday"]>>
<<set _npcviewerMouth to ["Happy", "Normal", "Sad", "Smirk"]>>
<<set _npcviewerEyes to ["Normal", "Narrow", "Wide", "Closed"]>>
<<set _npcviewerBrows to ["Normal", "Suspicious", "Angry", "Shocked"]>>
<<set _npcviewerBlush to [0, 1, 2, 3]>>
<<set _npcviewerCry to [0, 1, 2]>>
<<set _npcviewerArms to ["Normal", "Bound", "Hide"]>>
<<set _npcviewerHard to [0]>>
<<if $RandolphSocial >= 50 or $RandolphSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $RandolphSocial >= 100 or $RandolphSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Model Viewer Adults">>
</div>
<br>

:: Randolph NPC Character Menu Avatar Display [nobr]

<<set $NPCViewer to {
    Name: "Randolph",
    Outfit: "Everyday",
}>>

<<set _npcviewerOutfit to ["Everyday"]>>
<<set _npcviewerHard to [0]>>
<<if $RandolphSocial >= 50 or $RandolphSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $RandolphSocial >= 100 or $RandolphSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Viewer Adults">>
</div>
<br>
:: Teens Characters Social [nobr]

<<link"[Core Characters]">>
	<<replace"#SocialMenu">>
        <<include"Core Characters Social">>
    <</replace>>
<</link>>
 | 
<<link"[Children]">>
	<<replace"#SocialMenu">>
        <<include"Child Characters Social">>
    <</replace>>
<</link>>
 | 
<<link"[Preteens]">>
	<<replace"#SocialMenu">>
        <<include"Preteens Characters Social">>
    <</replace>>
    <</link>>
| 
<span style="color:lightgreen">[Teens]</span>
 |   
 <<link"[Adults]">>
	<<replace"#SocialMenu">>
        <<include"Adult Characters Social">>
    <</replace>>
<</link>>
 | 
<br>

<span style="color:Azure"><big><strong>--Teenage Characters--</strong></big></span><br>

<table style="border-collapse: separate; border-spacing: 15px 0;">
    <tr>
        <<if $ToggleOCKalim == 1 && $CompletedQuests.includes("Kalim: Introduction")>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative; width:100px; height:100px;">
                <<if $OCKalimSocialRank == 1>>
                     <img @src="`Images/Icons/Social/Pink.png`" style="width:100px; height:100px;">
                <<elseif $OCKalimSocial >= 50>>
                    <img @src="`Images/Icons/Social/Green.png`" style="width:100px; height:100px;">
                <<elseif $OCKalimSocial > -10 && $OCKalimSocial < 50>>
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                <<elseif $OCKalimSocial <= -10 && $OCKalimSocial > -50>>
                    <img @src="`Images/Icons/Social/Red.png`" style="width:100px; height:100px;">
                <<elseif $OCKalimSocial <= -50>>
                    <img @src="`Images/Icons/Social/Dark Red.png`" style="width:100px; height:100px;">
                <</if>>
                    <img @src="`Images/Icons/Social/Kalim1.png`" style="position:absolute; width:100px; height:100px;">
                    <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                        <<replace "#SocialMenu">>
                            <<include "OC Kalim NPC Character Menu">>
                        <</replace>>
                    <</link>>
                </span>
            </th>
        <<elseif $ToggleOCKalim == 1>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative;">
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                    <img @src="`Images/Icons/Social/Unknown.png`" style="position:absolute; width:100px; height:100px;"> 
                </span>
            </th>
        <</if>>
                <<if $ToggleOCBobby == 1 && $CompletedQuests.includes("Bobby: Farm Intro")>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative;   width:100px; height:100px;">
                <<if $OCBobbySocialRank == 1>>
                     <img @src="`Images/Icons/Social/Pink.png`" style="width:100px; height:100px;">
                <<elseif $OCBobbySocial >= 50>>
                    <img @src="`Images/Icons/Social/Green.png`" style="width:100px; height:100px;">
                <<elseif $OCBobbySocial > -10 && $OCBobbySocial < 50>>
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                <<elseif $OCBobbySocial <= -10 && $OCBobbySocial > -50>>
                    <img @src="`Images/Icons/Social/Red.png`" style="width:100px; height:100px;">
                <<elseif $OCBobbySocial <= -50>>
                     <img @src="`Images/Icons/Social/Dark Red.png`" style="width:100px; height:100px;">
                <</if>>
                    <img @src="`Images/Icons/Social/Bobby1.png`" style="position: absolute; width:100px; height:100px;">
                    <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                        <<replace "#SocialMenu">>
                            <<include "OC Bobby NPC Character Menu">>
                        <</replace>>
                    <</link>>
                </span>
            </th>
        <<elseif $ToggleOCBobby == 1>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative;">
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                    <img @src="`Images/Icons/Social/Unknown.png`" style="position:absolute; width:100px; height:100px;"> 
                </span>
            </th>
        <</if>>
        <<if $ToggleOCZach == 1 && $CompletedQuests.includes("Zach: Brochella Lite")>>
            <th>
                <span style="display: inline-flex; align-items:center; position:relative; width:100px; height:100px;">
                <<if $OCZachSocialRank == 1>>
                     <img @src="`Images/Icons/Social/Pink.png`" style="width:100px; height:100px;">
               <<elseif $OCZachSocial >= 50>>
                   <img @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
               <<elseif $OCZachSocial > -10 && $OCZachSocial < 50>>
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                <<elseif $OCZachSocial <= -10 && $OCZachSocial > -50>>
                    <img @src="`Images/Icons/Social/Red.png`" style="width:100px; height:100px;">
                <<elseif $OCZachSocial <= -50>>
                    <img @src="`Images/Icons/Social/Dark Red.png`" style="width:100px; height:100px;">
                <</if>>
                    <img @src="`Images/Icons/Social/Zach1.png`" style="position: absolute; width:100px; height: 100px;"> 
                    <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                        <<replace "#SocialMenu">>
                            <<include "OC Zach NPC Character Menu">>
                        <</replace>>
                    <</link>>
                </span>
            </th>
        <<elseif $ToggleOCZach == 1>>
            <th>
                <span style="display:inline-flex; align-items:center; position:relative;">
                    <img @src="`Images/Icons/Social/Blue.png`" style="width:100px; height:100px;">
                    <img @src="`Images/Icons/Social/Unknown.png`" style="position:absolute; width:100px; height:100px;"> 
                </span>
            </th>
        <</if>>
    </tr>
    <tr>
        <<if $ToggleOCKalim == 1 && $CompletedQuests.includes("Kalim: Introduction")>>
            <th style="text-align: center;">
            <<link"Kalim">>
                <<replace"#SocialMenu">>
                    <<include"OC Kalim NPC Character Menu">>
                <</replace>>
            <</link>>
            </th>
        <<elseif $ToggleOCKalim == 1>>
            <th style="text-align: center;">
                ????
            </th>
        <</if>>
        <<if $ToggleOCBobby == 1 && $CompletedQuests.includes("Bobby: Farm Intro")>>
            <th style="text-align: center;">
            <<link"Bobby">>
                <<replace"#SocialMenu">>
                    <<include"OC Bobby NPC Character Menu">>
                <</replace>>
            <</link>>
            </th>
        <<elseif $ToggleOCBobby == 1>>
            <th style="text-align: center;">
                ????
            </th>
        <</if>>
        <<if $ToggleOCZach == 1 && $CompletedQuests.includes("Zach: Brochella Lite")>>
            <th style="text-align: center;">
            <<link"Zach">>
                <<replace"#SocialMenu">>
                    <<include"OC Zach NPC Character Menu">>
                <</replace>>
            <</link>>
            </th>
        <<elseif $ToggleOCZach == 1>>
            <th style="text-align: center;">
                ????
            </th>
        <</if>>
    </tr>
        <tr>
        <<if $ToggleOCKalim == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCKalimSocial,
                        value: Math.abs($OCKalimSocial),
                        max: 100,
                        min: 0,
                        color: getSocialBarColor($OCKalimSocial),
                        showText: true,
                    })>>
                    <<progressbar _data>>
                </div>
            </th>
        <</if>>
        <<if $ToggleOCBobby == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCBobbySocial,
                        value: Math.abs($OCBobbySocial),
                        max: 100,
                        min: 0,
                        color: getSocialBarColor($OCBobbySocial),
                        showText: true,
                    })>>
                    <<progressbar _data>>
                </div>
            </th>
        <</if>>
        <<if $ToggleOCZach == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCZachSocial,
                        value: Math.abs($OCZachSocial),
                        max: 100,
                        min: 0,
                        color: getSocialBarColor($OCZachSocial),
                        showText: true,
                    })>>
                    <<progressbar _data>>
                </div>
            </th>
        <</if>>
    </tr>
</table>
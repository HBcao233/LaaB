    <tr>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $AlistairSocial,
                    value: Math.abs($AlistairSocial),
                    max: 100,
                    min: 0,
                    color: getSocialBarColor($AlistairSocial),
                    showText: true,
                })>>
                <<progressbar _data>>
	        </div>
        </th>
        <th>
            <div class="social-bar-gauge">
                <<set _data = clone({
                    text: $RandolphSocial,
                    value: Math.abs($RandolphSocial),
                    max: 100,

:: Adult Characters Social [nobr]

<<link"[Core Characters]">>
	<<replace"#SocialMenu">>
        <<include"Core Characters Social">>
    <</replace>>
<</link>>
 | 
<<link"[Children]">>
	<<replace"#SocialMenu">>
        <<include"Child Characters Social">>
    <</replace>>
<</link>>
 | 
<<link"[Preteens]">>
	<<replace"#SocialMenu">>
        <<include"Preteens Characters Social">>
    <</replace>>
<</link>>
     | 
<<link"[Teens]">>
	<<replace"#SocialMenu">>
        <<include"Teens Characters Social">>
    <</replace>>
<</link>>
 | 
<span style="color:lightgreen">[Adults]</span>
 | 
 <br>
 <span style="color:Azure"><big><strong>--Teachers--</strong></big></span><br>

<table style="border-collapse: separate; border-spacing: 15px 0;">
    <tr>
        <th>
            <span style="display:inline-flex; align-items:center; position:relative;width:100px; height:100px;">
                <<if $AlistairSocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $AlistairSocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $AlistairSocial > -10 && $AlistairSocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $AlistairSocial <= -10 && $AlistairSocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $AlistairSocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Alistair.png`" style="position: absolute; width: 100px; height: 100px;"> 
                <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                <<replace "#SocialMenu">>
                    <<include "Alistair NPC Character Menu">>
                <</replace>>
            <</link>>
            </span>
        </th>
        <th>
            <span style="display:inline-flex; align-items: center; position:relative;
            width:100px;height:100px;">
                <<if $RandolphSocialRank == 1>>
                     <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Pink.png`" style="width: 100px; height: 100px;">
                <<elseif $RandolphSocial >= 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Green.png`" style="width: 100px; height: 100px;">
                <<elseif $RandolphSocial > -10 && $RandolphSocial < 50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Blue.png`" style="width: 100px; height: 100px;">
                <<elseif $RandolphSocial <= -10 && $RandolphSocial > -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Red.png`" style="width: 100px; height: 100px;">
                <<elseif $RandolphSocial <= -50>>
                    <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Dark Red.png`" style="width: 100px; height: 100px;">
                <</if>>
                <img @title="_npc" @alt="_npc" @src="`Images/Icons/Social/Randolph.png`" style="position: absolute; width: 100px; height: 100px;"> 
                <<link '<span style="position:absolute; inset:0; width:100px; height:100px; display:block; cursor:pointer; z-index:10;"></span>'>>
                <<replace "#SocialMenu">>
                    <<include "Randolph NPC Character Menu">>
                <</replace>>
            <</link>>
            </span>
        </th>

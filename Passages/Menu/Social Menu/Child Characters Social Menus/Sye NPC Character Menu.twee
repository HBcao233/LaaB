:: Sye NPC Character Menu Model Viewer [nobr]

<<link"[Biography]">>
    <<replace"#NPCMenu">>
        <<include"Sye NPC Character Menu Biography">>
    <</replace>>
<</link>>
 | 
<<link"[Information]">>
    <<replace"#NPCMenu">>
        <<include"Sye NPC Character Menu Information">>
    <</replace>>
<</link>>
 | 
<<link"[Quests]">>
    <<replace"#NPCMenu">>
        <<include"Sye NPC Character Menu Quests">>
    <</replace>>
<</link>>
 | 
 <span style="color:lightgreen">[Model Viewer]</span>

    <<set $NPCViewer to {
        Name: "Sye",
        Outfit: "Everyday",
        Mouth: "Happy",
        Eyes: "Normal",
        Blush: 0,
        Cry: 0,
        Arms:  "Normal",
    }>>

<<set _npcviewerOutfit to ["Everyday","Pajamas"]>>
<<set _npcviewerMouth to ["Happy", "Normal", "Sad", "Smirk"]>>
<<set _npcviewerEyes to ["Normal", "Mad", "Sad", "Tired", "Left Wink", "Right Wink", "Closed"]>>
<<set _npcviewerBlush to [0, 1, 2, 3]>>
<<set _npcviewerCry to [0, 1, 2]>>
<<set _npcviewerArms to ["Normal", "Bound", "Hide"]>>
<<set _npcviewerbuehands to ["None", "Hands", "Hide", "Sleep"]>>
<<set _buehands to "None">>
<<set _npcviewerHard to [0]>>
<<if $SyeSocial >= 50 or $SyeSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $SyeSocial >= 100 or $SyeSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Model Viewer">>
</div>
<br>

:: Sye NPC Character Menu Avatar Display [nobr]

<<set $NPCViewer to {
    Name: "Sye",
    Outfit: "Everyday",
}>>

<<set _npcviewerOutfit to ["Everyday"]>>
<<set _npcviewerHard to [0]>>
<<if $CompletedQuests.includes("Sye: Swimming Lessons")>>
    <<set _npcviewerOutfit.push("Swim")>>
<</if>>
<<if $SyeSocial >= 50 or $SyeSocialRank > 0>>
    <<set _npcviewerOutfit.push("Undies")>>
<</if>>
<<if $SyeSocial >= 100 or $SyeSocialRank > 0>>
    <<set _npcviewerOutfit.push("Naked")>>
    <<set _npcviewerHard.push(1)>>
<</if>>
<div id='AvatarViewer'>
    <<include"Social NPC Viewer">>
</div>
<br>
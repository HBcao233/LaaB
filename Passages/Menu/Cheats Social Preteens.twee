    <tr>
        <<if $ToggleOCMiller == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCZaySocial,
                        value: Math.abs($OCZaySocial),
                        max: 100,
                        min: 0,
                        color: getSocialBarColor($OCZaySocial),
                        showText: true,
                    })>>
                    <<progressbar _data>>
                </div>
            </th>
        <</if>>
        <<if $ToggleOCSebastian == 1>>
            <th>
                <div class="social-bar-gauge">
                    <<set _data = clone({
                        text: $OCSebastianSocial,

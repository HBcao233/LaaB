        <</if>>
    </tr>
        <<if $ToggleOCMiller == 1>>
         <th>
        <<if $ToggleOCMiller == 1 && $CompletedQuests.includes("Millers: Meet the Millers")>>
        [[(--)|Cheats Menu][$OCZaySocial -= 10]]
        [[(-)|Cheats Menu][$OCZaySocial -= 5]]
        [[(+)|Cheats Menu][$OCZaySocial += 5]]
        [[(++)|Cheats Menu][$OCZaySocial += 10]]
        <</if>>
    </th>
        <</if>>

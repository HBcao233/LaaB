    <<addClothing "AD" "Socks" "School Socks" "Black">>
    <<addClothing "AD" "Outer" "School Jacket" "Rolled">>
    <<set $ADTopAlt to 1>>
    <<set $ADNeckAlt to 1>>
    <<set $ADOuterAlt to 1>>

<</if>>


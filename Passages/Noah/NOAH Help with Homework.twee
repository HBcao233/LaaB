:: NOAH Help with Homework [nobr]


<<set $RandomEvent to random(1, 3)>>

<<if $RandomEvent == 1>>
	<<include"NOAH Homework No Event">>
	
<<elseif $RandomEvent == 2>>
	<<include"NOAH Homework Hug Break">>
	
<<elseif $RandomEvent == 3>>
	<<include"NOAH Homework Strip Quiz">>
	
<</if>>

                },
                {
                    Name: "Player",
                    State: {
                        Mouth: "Smirk",
                        Eyes: "Tired",
                    },
                },
            ]>>
            <<ad _ad>>

        <span style="color:Pink">He quickly rolls off the swing, his momentum stopped by his near fall, as he quickly fixes his clothing to conceal his childish undergarments. You can’t help but chuckle at the sight, something <span style="color:DarkTurquoise">Noah</span> returns with slightly flushed cheeks.</span> <br>
        <<addMoodlet "Stress" 0>>
        <<needChange "Fun" 15>>
        <<socialChange "Noah" 3>>

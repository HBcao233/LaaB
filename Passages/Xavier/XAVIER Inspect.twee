:: XAVIER Inspect Gym [nobr]

	<<include"XAVIER Avatar Undies">>
	<span style="color:DarkTurquoise">Xavier</span> is surrounded by some of his followers as they all change. <span style="color:Pink">You notice that a few of them are eyeing his impressive physique, which is shown off perfectly as he stands there in nothing but his $XavierUndies.Name.</span> Despite everyone being in their underwear, something about being in the locker room makes it less intimate and embarrassing.<br>
	<<if $SeenXavierUndies < 1>>
		<<set $SeenXavierUndies += 1>>
	<</if>>

:: XAVIER Inspect Gym Shower [nobr]

	<<include"XAVIER Avatar Towel">>
	<span style="color:DarkTurquoise">Xavier</span> stands in front of his locker in nothing but a towel. He is holding up a small handheld mirror and fixing his hair after washing it. You notice his followers around him, occasionally stealing glances at the admittedly attractive boy. <br>


:: XAVIER Inspect School Waiting for Bus [nobr]

	<<include"XAVIER Avatar Everyday">>
	<span style="color:DarkTurquoise">Xavier</span> stands among his crowd waiting for his ride.<br>

	<div id="HangOutSchool">
		<<if $InActiveQuests.includes("Xavier: Hang Out Intro")>>
			<<link"Ask if Xavier wants to Hang Out">>
			<<set $HangOutNeed to {
				Energy: 100,
				Fun: 20,
				Comfort: 20,
			}>>
			<<goto "Xavier Hang Out First Time">>
			<</link>><br>
		<<elseif $CompletedQuests.includes("Xavier: Hang Out Intro")>>
			<<link"Want to hang out?">>
			<<replace"#HangOutSchool">>
				<span style="color:Yellow">Where?</span><br>
				<<set $HangOutNeed to {
					Energy: 100,
					Fun: 20,
					Comfort: 20,
				}>>
				<<link"The Park (0:10)<br>">>
					<<set $HangOutClothes to "Uniform">>
					<<set $Minutes += 10>>
					<<goto "Xavier Hang Out Go To Park">>
				<</link>>
			<</replace>>
			<</link>>
		<</if>>
	</div>
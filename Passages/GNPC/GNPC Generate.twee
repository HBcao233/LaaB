	<</if>>

/* UNDERWEAR TYPE */
<<set $GNPCUndiesGen to random(1, 3)>>
	<<if $GNPCUndiesGen == 1>>
		<<set $GNPCUndies to "Briefs">>
	<<elseif $GNPCUndiesGen == 2>>
		<<set $GNPCUndies to "Boxer Briefs">>
	<<elseif $GNPCUndiesGen == 3>>
		<<set $GNPCUndies to "Boxers">>
	<</if>>


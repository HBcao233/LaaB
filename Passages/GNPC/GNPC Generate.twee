/* BOTTOM TYPE */
<<set $GNPCBottomGen to random(1, 2)>>
	<<if $GNPCBottomGen == 1>>
		<<set $GNPCBottoms to "Shorts">>
	<<elseif $GNPCBottomGen == 2>>
		<<set $GNPCBottoms to "Jeans">>
	<</if>>

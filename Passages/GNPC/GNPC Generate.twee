	<<elseif $GNPCTopColorGen == 5>>
		<<set $GNPCTopColor to "Red">>
	<<elseif $GNPCTopColorGen == 6>>
		<<set $GNPCTopColor to "Purple">>
	<<elseif $GNPCTopColorGen == 7>>
		<<set $GNPCTopColor to "Black">>
	<<elseif $GNPCTopColorGen == 8>>

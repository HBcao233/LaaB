                    <<set $AchievementArt.push("Lucas Character Art Naked")>>
                    <<run $Achievements.usePoints(1)>>
                    <<goto"Artwork Catalog Lucas">>
                <</link>>
            <<else>>
                <span style="color:lightcoral">[Can't Afford]</span><br>
            <</if>>

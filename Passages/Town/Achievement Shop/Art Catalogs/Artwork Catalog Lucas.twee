        <strong><span style="color:lightgreen">Lucas Character Art (Hard)</span></strong>
        | 
        <<apsart "Images\\Special\\Character Art\\Lucas\\Lucas Hard.png" "Rayray" "https://rayrayart.fanbox.cc">>

        | 
        <<if $LucasSocial >= 100 and $LucasSocialRank == 1>>
            <<if $Achievements.getRemainingPoints() >= 1>>
                <<link"[Buy]<br>">>
                    <<set $AchievementArt.push("Lucas Character Art Hard")>>
                    <<run $Achievements.usePoints(1)>>

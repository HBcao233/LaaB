:: Artwork Catalog Kade [nobr]

<span style="color:Azure"><big><strong>--Kade Catalog--</strong></big></span><br>
<br>

<strong>Current AP:</strong> <<=$Achievements.getRemainingPoints()>><br>
<br>
<span style="color:Azure"><strong>-Artwork (1AP)-</strong></span><br>

/* Character Art (Everyday) */
    <<if $AchievementArt.includes("Kade (Towel)")>>
        <strong><span style="color:lightgreen">Kade (Towel)</span></strong>
        | 
        <<apsart "Images\\Special\\Buyable\\OC\\Kade\\Kade Towel.png" "Rayray" "https://rayrayart.fanbox.cc">>
    <<else>>
        <strong>Kade (Towel)</strong>
        | 
        <<if $Achievements.getRemainingPoints() >= 1>>
            <<link"[Buy]<br>">>
                <<set $AchievementArt.push("Kade (Towel)")>>
                <<run $Achievements.usePoints(1)>>
                <<goto"Artwork Catalog Kade">>
            <</link>>
        <<else>>
            <span style="color:lightcoral">[Can't Afford]</span><br>
        <</if>>
    <</if>>
/* Character Art (Undies) */
    <<if $AchievementArt.includes("Kade (Naked)")>>
        <strong><span style="color:lightgreen">Kade Character Art (Naked)</span></strong>
        | 
        <<apsart "Images\\Special\\Buyable\\OC\\Kade\\Kade Naked.png" "Rayray" "https://rayrayart.fanbox.cc">>
    <<else>>
        <strong>Kade Character Art (Naked)</strong>
        | 
        <<if $KadeSocial >= 100 or $KadeSocialRank > 0>>
            <<if $Achievements.getRemainingPoints() >= 1>>
                <<link"[Buy]<br>">>
                    <<set $AchievementArt.push("Kade (Naked)")>>
                    <<run $Achievements.usePoints(1)>>
                    <<goto"Artwork Catalog Kade">>
                <</link>>
            <<else>>
                <span style="color:lightcoral">[Can't Afford]</span><br>
            <</if>>
        <<else>>
            <span style="color:lightcoral">[LOCKED (Max Kade Social Rank 0)]</span><br>
        <</if>>
    <</if>>
<br>
[[Back|Artwork Catalog]]
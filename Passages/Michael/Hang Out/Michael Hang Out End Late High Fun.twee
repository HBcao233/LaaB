                Eyes: "Tired",
                },
            },
            {
            Name: "Michael",
            State: {
                Outfit: $HangOutClothes,
                Mouth: "Smirk",
                Eyes: "Mad",
                },
            },
        ]>>
        <<ad _ad>>

        <span style="Color: LightSteelBlue">“Not everyone is gay like you. I don’t give my friends a hug and kiss goodbye. You know, because I’m a normal person!”</span> He explains as you look up and teasingly comment that if he wants a kiss goodbye as well, all he has to do is ask! <span style="color:LightGreen"> <span style="color:DarkTurquoise">Michael</span> then spends the next few seconds holding you back to prevent you kissing him until he is able to escape.</span> <span style="Color: LightSteelBlue">“Damn, you’re pretty gay.”</span> <span style="color:DarkTurquoise">Michael</span> laughs, <span style="Color: LightSteelBlue">“Later, gay boy!”</span><br>

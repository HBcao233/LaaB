        <<goto "CC Attributes">>
    <</link>>
<</if>><br>
*/
<<if $CanCum != 1>>
	<<link "$Player.Name has dry orgasms.">>
    	<<set $CanCum to 1>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
    <</link>>
<<elseif $CanCum == 1>>
	<<link "$Player.Name can produce cum.">>
    	<<set $CanCum to 0>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
    <</link>>
<</if>><br>


<span style="color:Azure"><strong>--Family Details--</strong></span><br>
<<if $NoahWetting != 1>>
	<<link "Noah does not wet the bed">>
    	<<set $NoahWetting to 1>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
    <</link>>
<<elseif $NoahWetting == 1>>
	<<link "Noah does wet the bed">>
    	<<set $NoahWetting to 0>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
    <</link>>
<</if>><br>

<span>Noah Appearance:</span>
<<if $NoahAppearance == 1>>
	<<link"Same as PC">>
		<<set $NoahAppearance to 0>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
	<</link>><br>
<<else>>
	<<link"Custom">>
		<<set $NoahAppearance to 1>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
	<</link>><br>
	<div style="text-indent: 3em;">
		<span>Skin Color:</span> 
		<<listbox "$Noah.SkinColor" autoselect>>
			<<optionsfrom $SkinColorOptions>>
		<</listbox>>
	</div>
	<div style="text-indent: 3em;">
		<span>Hair Color:</span>
		<<listbox "$Noah.HairColor" autoselect>>
			<<optionsfrom $HairColorOptions>>
		<</listbox>>
	</div>
	<div style="text-indent: 3em;">
	<span>Eye Color:</span>
	<<listbox "$Noah.EyeColor" autoselect>>
		<<optionsfrom $EyeColorOption>>
	<</listbox>>
</div>
	<div style="text-indent: 3em;">
<span>Penis Style:</span>
	<<listbox "$Noah.PenisStyle" autoselect>>
		<<optionsfrom ['Cut', 'Uncut']>>
	<</listbox>>
	</div>
<</if>>
<span>Gabe Appearance:</span>
<<if $GabeAppearance == 1>>
	<<link"Same as PC">>
		<<set $GabeAppearance to 0>>
		<<replace"#CC">>
			<<include"CC Details">>
		<</replace>>
	<</link>><br>
<<else>>

    /* Checking Partner */
    <<if $Sex.PartnerClothes.Top == 1 && $Sex.PartnerClothes.Bottoms == 1>>
        <<set _PartnerClothes to 1>>
    <<elseif $Sex.PartnerClothes.Bottoms != 1 && $Sex.PartnerClothes.Undies == 1>>

        <<set _PCClothes to 1>>
    <<elseif $Sex.PCClothes.Bottoms != 1 && $Sex.PCClothes.Undies == 1>>
        <<set _PCClothes to 0>>
        /* Clothes reset here until Variants are written */
        <<set _PCClothes to 1>>
    <<elseif $Sex.PCClothes.Bottoms != 1 && $Sex.PCClothes.Undies != 1>>
        <<set _PCClothes to -1>>

        <</replace>>
    <</requiresTrait>>

    <<requiresTrait "Brave" "Walk up confidently">>
        <<replace"#choice">>

            <<set _ad to [
                { 
                    Name: "Player",
                    State: {
                        Mouth: "Smirk",
                    },

<div style="position: relative">
	<<include"Avatar Display">>
/* SECOND LAYER */
	<<set $AD.Name to "Felix">>
	<<set $AD.Arms to "Normal">>
	<<set $AD.Eyes to "Normal">>
	<<set $AD.Cry to 0>>
	<<set $AD.Blush to 0>>
	<<set $AD.Mouth to "Happy">>
	<<set $AD.Outfit to "Everyday">>
	<<set $AD.Hard to 0>>
	<<include"FELIX Avatar Equipment Set">>

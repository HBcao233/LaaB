<div style="position: relative">
	<<include"Teen Avatar Display">>
/* SECOND LAYER */
	<<set $AD.Name to "Noah">>
	<<set $AD.Arms to "Normal">>
	<<set $AD.Eyes to "Sad">>
	<<set $AD.Cry to 1>>
	<<set $AD.Blush to 0>>
	<<set $AD.Mouth to "Happy">>
	<<set $AD.Outfit to "Everyday">>
	<<set $AD.Hard to 0>>

    <<set $ADNeck to $None>>
    <<set $ADOuter to $None>>
    <<set $ADSocks to $None>>
    <<set $ADShoes to $None>>
    <<set $ADUndies to $None>>
    <<set $ADUnder to $None>>
<</if>>

<<if $AD.Outfit == "Gym">>
    <<addClothing "AD" "Top" "Gym Shirt" "School">>
    <<addClothing "AD" "Bottoms" "Gym Shorts" "School">>
    <<set $ADNeck to $None>>
    <<set $ADOuter to $None>>

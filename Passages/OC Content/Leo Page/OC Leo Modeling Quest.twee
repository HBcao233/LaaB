<<set $OddJobsCount += 1>>
<<for _i to 0; _i lt $RandomJobList.length; _i++>>
    <<capture _i>>
        <<if $RandomJobList[_i].Type == "Leo Quest">>
            <<set $RandomJobList.deleteAt(_i)>>
        <</if>>
    <</capture>>
<</for>>
<br>
[[Continue|Entertainment District]]

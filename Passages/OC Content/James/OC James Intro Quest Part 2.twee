            )>>
            <<set $Notifications.push({
                Name: "Quest Acquired!",
                Icon: "Quests/James",
                Description: "You have agreed to help your classmate <span style=\"color:DarkTurquoise\">James</span> investigate the <span style=\"color:Teal\">Mysterious Abandoned Shop</span> at the <span style=\"color:Teal\">Boardwalk</span>. After some investigating, you've decided to return after dark. You need to meet <span style=\"color:DarkTurquoise\">James</span> at the <span style=\"color:Teal\">Boardwalk</span> on <span style=\"color:Teal\">Saturday</span> between <span style=\"color:Teal\">8PM</span> and <span style=\"color:Teal\">10PM</span>.",
            })>>
            <br>

<<set $CompletedQuests.push("James: The Orange Mystery Part 1")>>
<<for _i to 0; _i lt $QuestLog.length; _i++>>
    <<if $QuestLog[_i].Name == "James: The Orange Mystery Part 1">>
        <<set $QuestLog.deleteAt(_i)>>
        <<break>>
    <</if>>
<</for>>
<<set $Notifications.push({
    Name: "Quest Completed!",
    Icon: "Quests/James",
    Description: "You and <span style=\"color:DarkTurquoise\">James</span> have begun your investigation into the Mysterious Abandoned Shop. Strange things are afoot, but you'll have to wait until he contacts you to continue your investigation.",
})>>

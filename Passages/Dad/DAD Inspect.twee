:: DAD Inspect Hallway [nobr]

	<span style="color:DarkTurquoise">Your Father</span> walks down the hallway, reading through the messages on his phone.<br>
	<<set _ad to [
		{
			Name: "Dad",
			State: {
				Eyes: "Narrow",
				Mouth: "Frown",
			},
		},
	]>>
	<<ad _ad>>

	[[Give him a hug (0:02)|Dad Hug]]<br>
	<<if $PlayerBottoms.Type != "None" && $PlayerBottoms.Type != "Towel">>
		<div id="HangOutHome">
		<<if $InActiveQuests.includes("Dad: Hang Out Intro")>>
			<<link"Ask if Dad wants to Hang Out">>
			<<set $HangOutNeed to {
				Energy: 100,
				Fun: 20,
				Comfort: 20,
			}>>
			<<goto "Dad Hang Out First Time">>
			<</link>><br>
		<<elseif $CompletedQuests.includes("Dad: Hang Out Intro")>>
			<<link"Want to hang out?">>
			<<replace"#HangOutHome">>
				<span style="color:Yellow">Where?</span><br>
				<<set $HangOutNeed to {
					Energy: 100,
					Fun: 20,
					Comfort: 20,
				}>>
				<<link"The Park (0:10)<br>">>
					<<set $HangOutClothes to "Everyday">>
					<<set $Minutes += 10>>
					<<goto "Dad Hang Out Go To Park">>
				<</link>>
			<</replace>>
			<</link>>
		<</if>>
		</div>
	<</if>>

:: DAD Inspect Breakfast [nobr]

	<span style="color:DarkTurquoise">Your Father</span> sits at the nook eating his breakfast and drinking his morning coffee. He seems pretty tired.<br>
	<<set _ad to [
		{
			Name: "Dad",
			State: {
				Mouth: "Smile",
			},
		},
	]>>
	<<ad _ad>>

	<<if $Breakfast != 1>>
		[[Eat With (0:15)|DAD Eat With][$EatWith to "Breakfast"]]<br>
	<</if>>


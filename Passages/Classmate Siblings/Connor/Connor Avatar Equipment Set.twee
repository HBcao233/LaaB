<<addClothing "AD" "Shoes" "Sneakers" "Black">>
<<set $ADShortsSag to 1>>

<<set $ADMoles to {
    CheekLeft: 0,
    CheekRight: 0,
    LipLeft: 0,
    LipRight: 0,
    PubicLeft: 0,
    PubicRight: 0,
}>>
<<set $ADNoseHeavyFreckles to 0>>
<<set $ADNoseLightFreckles to 0>>
<<set $ADLeftSmallFreckles to 0>>
<<set $ADRightSmallFreckles to 0>>

<<if $ADMuscleToggle == 1>>
	<<set $AD.Build to "Normal">>
<<else>>
	<<set $AD.Build to "Normal">>
<</if>>

<<if $ADPubicHairToggle == 1>>
	<<set $AD.PubicHair to "None">>
<<else>>
	<<set $AD.PubicHair to "None">>
<</if>>

/* DEFAULT SETTING */
	<<set $ADHead to $None>>
    <<set $ADFace to $None>>
    <<set $ADMouth to $None>>
    <<set $ADNeck to $None>>

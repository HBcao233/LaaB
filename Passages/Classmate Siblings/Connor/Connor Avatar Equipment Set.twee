    <<addClothing "AD" "Neck" "School Tie" "School">>
    <<addClothing "AD" "Socks" "School Socks" "Black">>
    <<set $ADTopAlt to 1>>
    <<set $ADOuterAlt to 1>>
    <<set $ADOuter to $None>>
    <<set $ADUnder to $None>>
<</if>>


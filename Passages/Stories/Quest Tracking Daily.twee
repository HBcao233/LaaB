:: Quest Tracking Daily [nobr]

/* Quest Tracking/Triggers */
	/* These are passages that should be in the same file below, simply seperated for ease of use.
	Each one works like so:
	First, we check if the Listed Quest is in the UnavailableQuests Array.
	Then, we check if the Quest Conditions are met.
	If so, we remove it from UnavailableQuests and add to InActive.
	Each each will also have a note listing any required Trigger Times. This is to make it easier to set up their triggers and to double-check everything is working.
	Conditions & Trigger Times should also be listed in the spreadsheer of the Quests. 
	
	[Note: Toggle Conditions are checked when the event can pop, not during this phase, since toggles can change mid-gameplay.]
	*/
<<include "Quest Tracking Daily Family">>
<<include "Quest Tracking Daily Classmates">>
<<include "Quest Tracking Daily Side Characters">>
<<include "Quest Tracking Daily Supporter Characters">>

/* Checking if Inactive Quests are still Available */
<<include "Quest Tracking Remove Inactive Quests">>

/* Repeatable Quests Resets */
/* Chores:
	-Chores are assigned randomly at the start of the game if it is Monday. */
<<if $Time.Day == "Monday">>
	<<if $CompletedQuests.includes("Chores")>>
		<<set $CompletedQuests.delete("Chores")>>
	<<else>>
		<<set $Punishment += 20>>
		<<set $PunishmentReason.push("Chores")>>
	<</if>>
	<<set $ActiveQuests.push("Chores")>>
	<<set _outdoorChore to [
		{
			Name: "Mow Lawn",
			State: 0,
			Total: 1,
		},
		{
			Name: "Pull Weeds",
			State: 0,
			Total: 1,
		},
	]>>
	<<set _hardChore to [
		{
			Name: "Vacuum",
			State: 0,
			Total: 1,
		},
		{
			Name: "Do Laundry",
			State: 0,
			Total: 1,
		},
		{
			Name: "Take out Trash",
			State: 0,
			Total: 1,
		},
	]>>
	<<set _easyChore to [
		{
			Name: "Mop",
			State: 0,
			Total: 3,
			Tags: [],
		},
	]>>
	<<for _i to 0; _i lt $QuestLog.length; _i++>>
		<<if $QuestLog[_i].Name == "Weekly Chores">>
			<<set $QuestLog.deleteAt(_i)>>
			<<break>>
		<</if>>
	<</for>>
	<<set $QuestLog.push(
		{
			Name: "Weekly Chores",
			State: 0,
			ID: "Jobs_R001",
			Category: "Job",
			Type: "Quest",
			Icon: "Chore",
			Tags: ["Father", "Job", "Quest", "Deadline"],
			Description: "<span style=\"color:DarkTurquoise\">Your Father</span> expects you and your brothers to complete weekly chores in exchange for an allowance. Failure to do your chores will leave you in trouble with <span style=\"color:DarkTurquoise\">Your Father</span>.",
			Deadline: "Monday",
			Objectives: [
				_outdoorChore.random(),
				_hardChore.random(),
				_easyChore.random(),
			],
		},
	)>>
	<<set $Notifications.push({
		Name: "Quest Acquired!",
		Icon: "Traits/Neat",
		Description: "<span style=\"color:DarkTurquoise\">Your Father</span> have given you your chores for the week. He expects them to be done by this upcoming Monday in return for your weekly allowance. Careful, <span style=\"color:DarkTurquoise\">Your Father</span> is known to get upset if chores aren't finished. You can find more information in your <strong>Quest Menu</strong>.",
	})>>
<</if>>
/* Noah: Missing Toy */
<<if $Time.Day == "Wednesday">>
	/* Noah's Missing Toy quest is repeatable. As long as the quest is not already active. it has a 25% chance to retrigger every Wednesday. */
	<<if !$ActiveQuests.includes("Noah: Missing Toy") && random(1, 4) == 1>>
		<<set $InActiveQuests.push("Noah: Missing Toy")>>
		<<set $UnavailableQuests.delete("Noah: Missing Toy")>>
		/* Repeatable Quests aren't always removed from the Completed Quest Array. In this case, it is left there to indicate the quest has been completed at least once. During the Completion Passage for this quest, only add it to the Completed Array if it isn't already there. Otherwise, just remove from Active Quests. */
	<</if>>
<</if>>

/* Laser Pointer Event */
<<if $ToggleNonCon == 1 && random(1, 100) <= 5>>
	<<if $LaserPointer.Active == 1>>

	<<elseif $LaserPointer.Active == -1>>
		<<set $ActiveQuests.push("Laser Pointer")>>
		<<set $LaserPointer to {
			Active: 0,
			Exposed: "Clothed",
			Show: 0,
			Days: 0,
			Repeat: 1,
			Kids: 0,
			Preteens: 0,
			Teens: 0,
		}>>
	<<else>>
		<<set $ActiveQuests.push("Laser Pointer")>>
		<<set $LaserPointer to {
			Active: 0,
			Exposed: "Clothed",
			Show: 0,
			Days: 0,
			Repeat: 1,
			Kids: 0,
			Preteens: 0,
			Teens: 0,
		}>>
	<</if>>
	<<if $Debug == 1>>
		<<set $Notifications.push({
			Name: "Debug Note!",
			Icon: "Traits/Evil",
			Description: "This is a Debug Note. Laser Pointer Bedroom repeatable quest has been activated.",
		})>>
	<</if>>
<</if>>
<<if $LaserPointer.Days > 0>>
	<<set $LaserPointer.Days -= 1>>
	<<if $LaserPointer.Kids > 0>>
		<<set $LaserPointer.Kids -= 1>>
	<</if>>
	<<if $LaserPointer.Preteens > 0>>
		<<set $LaserPointer.Preteens -= 1>>
	<</if>>
	<<if $LaserPointer.Teens > 0>>
		<<set $LaserPointer.Teens -= 1>>
	<</if>>
<<elseif $LaserPointer.Days == 0>>
	<<set $LaserPointer to {
		Active: 0,
		Exposed: "Clothed",
		Show: 0,
		Days: 0,
		Repeat: 1,
		Kids: 0,
		Preteens: 0,
		Teens: 0,
	}>>
<</if>>

/* OC Events */
/* Erin: Closet Tired */
<<if $ToggleOCErin == 1 && $CompletedQuests.includes("Erin: Introduction") && $Time.schoolday() && random(1, 4) == 1>>
	<<if $Debug == 1>>
		<<set $Notifications.push({
			Name: "Debug Note!",
			Icon: "Traits/Evil",
			Description: "This is a Debug Note. Erin's Closet Bound repeatable quest has been activated for the day.",
		})>>
	<</if>>
	<<set $ActiveQuests.push("Erin: Closet Bound")>>
<<else>>
	<<set $ActiveQuests.delete("Erin: Closet Bound")>>
<</if>>
/* Kyren: Repeatable Opening if not Helped */
<<if $ToggleOCKyren == 1 && !$CompletedQuests.includes("Kyren: Intro") && $ActiveQuests.includes("Kyren: Intro")>>
	<<set $ActiveQuests.delete("Kyren: Intro")>>
	<<set $InActiveQuests.push("Kyren: Intro")>>
<</if>>


:: Quest Tracking Daily Family [nobr]

/* Noah */
<<if $UnavailableQuests.includes("Noah: Booster Shot")>>
	/* At least Half Social with Noah
	Triggers: Weekends before 4PM in the Living Room. */
	<<if $NoahSocial >= 50>>
		<<set $UnavailableQuests.delete("Noah: Booster Shot")>>
		<<set $InActiveQuests.push("Noah: Booster Shot")>>
	<</if>>
<</if>>

/* Noah: Missing Toy is a Repeatable Quest and is thus listed there. */

<<if $UnavailableQuests.includes("Noah: Stormy Night")>>
	/* At least 100 Social with Noah & "Noah: Booster Shot" completed.
	Triggers: Friday/Saturday between 6PM and 8PM in the Living Room
		Rank Up Quest */
	<<if $NoahSocial >= 100 && $CompletedQuests.includes("Noah: Booster Shot")>>
		<<set $UnavailableQuests.delete("Noah: Stormy Night")>>
		<<set $InActiveQuests.push("Noah: Stormy Night")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Noah: Accident")>>
	/* Requires Social Rank 1+ with Noah & For Noah to be a Bedwetter.
		Note: A Non-Bed Wetter version of this event is planned, once that occurs it will no longer be a condition.
	Triggers: Schoolday between 3:20PM and 3:40PM in the Living Room. */
	<<if $NoahSocialRank > 0 && $NoahWetting == 1>>
		<<set $UnavailableQuests.delete("Noah: Accident")>>
		<<set $InActiveQuests.push("Noah: Accident")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Noah: Swimming Lessons")>>
	/* Requires Social Rank 1+ with Noah & for the "Noah: Swimming Lessons" Swimming Perk to be unlocked.
	Triggers: Schoolday between 3:20PM and 3:40PM in the Living Room. */
	<<if $NoahSocialRank > 0 && $Skill.Perks.includes("Noah: Swimming Lessons")>>
		<<set $UnavailableQuests.delete("Noah: Swimming Lessons")>>
		<<set $InActiveQuests.push("Noah: Swimming Lessons")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Noah: Hang Out Intro")>>
	/* Requires Social 10+
	Triggers: Asking to Hang Out After School */
	<<if $NoahSocial >= 10>>
		<<set $UnavailableQuests.delete("Noah: Hang Out Intro")>>
		<<set $InActiveQuests.push("Noah: Hang Out Intro")>>
	<</if>>
<</if>>

/* Gabe */
<<if $UnavailableQuests.includes("Gabe: Sneak Out")>>
	/* Requires +50 or -50 Social with Gabe.
	Triggers: When PC goes to sleep in their bed at night on Sunday. */
	<<if $GabeSocial >= 50 or $GabeSocial <= -50>>
		<<set $UnavailableQuests.delete("Gabe: Sneak Out")>>
		<<set $InActiveQuests.push("Gabe: Sneak Out")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Gabe: Bail Out")>>
	/* Requires -100 Social with Gabe & NonCon to be Toggled On & Noah's Booster Shot Quest Completed.
	Triggers: Living room between 5PM and 7PM.
		Bad End Quest */
	<<if $GabeSocial <= -100 && $CompletedQuests.includes("Noah: Booster Shot") && $ToggleNonCon == 1>>
		<<set $UnavailableQuests.delete("Gabe: Bail Out")>>
		<<set $InActiveQuests.push("Gabe: Bail Out")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Gabe: Hang Out Intro")>>
	/* Requires Social 50+
	Triggers: Asking to Hang Out At Home */
	<<if $GabeSocial >= 50>>
		<<set $UnavailableQuests.delete("Gabe: Hang Out Intro")>>
		<<set $InActiveQuests.push("Gabe: Hang Out Intro")>>
	<</if>>
<</if>>

/* Dad */
<<if $UnavailableQuests.includes("Dad: Dragged Shopping")>>
	/* Requires 30+ Social with Dad.
	Triggers: Non-School Days between 10AM and 5PM */
	<<if $GabeSocial >= 30>>
		<<set $UnavailableQuests.delete("Dad: Dragged Shopping")>>
		<<set $InActiveQuests.push("Dad: Dragged Shopping")>>
	<</if>>
<</if>>
<<if $UnavailableQuests.includes("Dad: Hang Out Intro")>>
	/* Requires Social 20+
	Triggers: Asking to Hang Out At Home */
	<<if $DadSocial >= 20>>
		<<set $UnavailableQuests.delete("Dad: Hang Out Intro")>>
		<<set $InActiveQuests.push("Dad: Hang Out Intro")>>
	<</if>>
<</if>>

:: Quest Tracking Daily Classmates [nobr]


:: Fox Woods Dream [nobr]

/* Intro */

/* LOCATION */
<<set $Location to {
	Name: "Wald Street",
    Indoors: 0,
    Safe: 0,
    Nudity: 0,
    Public: 1,
    Environment: "Neighborhood",

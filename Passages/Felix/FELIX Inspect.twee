:: FELIX Inspect Waiting for Bus [nobr]

	<<include"FELIX Avatar Everyday">>
	<span style="color:DarkTurquoise">Felix</span> whistles while he waits for the bus to arrive.<br>
	<div id="HangOutSchool">
		<<if $InActiveQuests.includes("Felix: Hang Out Intro")>>
			<<link"Ask if Felix wants to Hang Out">>
			<<set $HangOutNeed to {
				Energy: 100,
				Fun: 20,
				Comfort: 20,
			}>>
			<<goto "Felix Hang Out First Time">>
			<</link>><br>
		<<elseif $CompletedQuests.includes("Felix: Hang Out Intro")>>
			<<link"Want to hang out?">>
			<<replace"#HangOutSchool">>
				<span style="color:Yellow">Where?</span><br>
				<<set $HangOutNeed to {
					Energy: 100,
					Fun: 20,
					Comfort: 20,
				}>>
				<<link"The Park (0:10)<br>">>
					<<set $HangOutClothes to "Uniform">>
					<<set $Minutes += 10>>
					<<goto "Felix Hang Out Go To Park">>
				<</link>>
			<</replace>>
			<</link>>
		<</if>>
	</div>
	<br>
	[[Leave|Middle School]] 


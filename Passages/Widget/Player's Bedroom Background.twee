                    <</replace>>
                <</link>>
            <</if>>
            | 
        <</capture>>
    <</for>><br>
</div>

<strong>Center Room</strong>: $PBedroom.Toybox<br>
<div style="margin-left: 30px;">
    <<for _i to 0; _i lt _toyboxoptions.length; _i++>>
        <<capture _i>>
            <<if $PBedroom.Toybox == _toyboxoptions[_i]>>
                <span style="color:Lightgreen">[_toyboxoptions[_i]]</span>
            <<else>>
                <<link _toyboxoptions[_i]>>
                    <<set $PBedroom.Toybox to _toyboxoptions[_i]>>
                    <<replace "#PBedroomEdit">>
                        <<include"Player's Bedroom Background Edit Div">>
                    <</replace>>
                <</link>>
            <</if>>
            | 
        <</capture>>
    <</for>><br>
</div>
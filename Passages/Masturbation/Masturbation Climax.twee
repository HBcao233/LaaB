			<<set _Random to ["Masturbation Climax Bedroom Laying Bed Normal", "Masturbation Climax Bedroom Laying Bed Mouth"]>>
		<<else>>
			<<set _Random to ["Masturbation Dry Climax Bedroom Laying Bed Normal"]>>
